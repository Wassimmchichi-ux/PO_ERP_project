# Copy this file to .env and fill in real values for your machine.
# Never commit the actual .env file.

# --- Application ---
APP_NAME=Launch PO System
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# Used later for JWT signing / session security. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-every-environment

# --- Database ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/launch_po_dev

# --- CORS ---
# Comma-separated list of allowed origins for the frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
